{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Flutter: run Tournament Hub",
      "type": "shell",
      "command": "make run",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Flutter: run Widgetbook",
      "type": "shell",
      "command": "make run-widgetbook",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Tournament Hub: prepare Spectator Web",
      "type": "process",
      "command": "dart",
      "args": ["run", "tool/project.dart", "build-spectator"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
